{
  "name": "electron-browser-builtin",
  "productName": "Electron Browser Builtin",
  "version": "0.1.0",
  "description": "Desktop workspace shell: chat on the left, browser/files/terminal on the right",
  "main": "./out/main/index.js",
  "author": "yuser1",
  "license": "ISC",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "dist": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --win --dir"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9",
    "vite": "^8.3.5",
    "zustand": "^5.0.16"
  }
}
